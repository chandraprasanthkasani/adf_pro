{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafact36"
		},
		"la_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'la_adls'"
		},
		"ls_sql_database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sql_database'"
		},
		"la_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsacct1.dfs.core.windows.net/"
		},
		"ls_RestService1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": " https://pokeapi.co/api/v2/pokemon"
		},
		"ls_sql_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlserverprocour.database.windows.net"
		},
		"ls_sql_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sqldatabasepro"
		},
		"ls_sql_database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "root1234"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafact36_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"la_adls_accountKey": {
						"value": "[parameters('la_adls_accountKey')]"
					},
					"ls_sql_database_password": {
						"value": "[parameters('ls_sql_database_password')]"
					},
					"la_adls_properties_typeProperties_url": {
						"value": "[parameters('la_adls_properties_typeProperties_url')]"
					},
					"ls_RestService1_properties_typeProperties_url": {
						"value": "[parameters('ls_RestService1_properties_typeProperties_url')]"
					},
					"ls_sql_database_properties_typeProperties_server": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_server')]"
					},
					"ls_sql_database_properties_typeProperties_database": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_database')]"
					},
					"ls_sql_database_properties_typeProperties_userName": {
						"value": "[parameters('ls_sql_database_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}